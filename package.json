{
  "name": "customer-project-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Local customer project archive and engineering workbench prototype.",
  "scripts": {
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-playwright.ps1 test",
    "test:e2e:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-playwright.ps1 ui",
    "test:e2e:headed": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-playwright.ps1 headed",
    "playwright:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-playwright.ps1 install"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
